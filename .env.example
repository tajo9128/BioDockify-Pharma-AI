# BioDockify Environment Variables Example
# Copy this file to .env and fill in your keys

# AI Providers
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM Keys (leave blank if using the local BioDockify AI Engine or host Ollama)
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AWS Bedrock (for Claude Sonnet 5 via Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# BioDockify AI Engine — optional local LLM sidecar (Bonsai-8B)
# To enable: just run `docker compose up -d` — model downloads automatically on first start
# Then select the "BioDockify AI Engine — Local (Bonsai-8B)" preset in Settings → Models.
# LOCAL_LLM_HOST=llama-server
# LOCAL_LLM_PORT=8080
# BONSAI_MODEL_ID=bonsai-8b

# Database
DATABASE_URL=postgresql://biodockify:biodockify@db:5432/biodockify
REDIS_URL=redis://redis:6379/0

# Vector DB
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=/app/data/chroma
MEMORY_PERSIST_DIR=/app/data/chroma_memory

# Monitoring
ENABLE_MONITORING=true
SENTRY_DSN=

# Security
BIODOCKIFY_EMERGENCY_SECRET=your-random-secret-here
ENVIRONMENT=development

# Web UI Port (default: 80)
WEB_UI_PORT=80

# Web UI login (optional). If AUTH_LOGIN is empty, UI stays open (AUTH BYPASS warning).
# AUTH_LOGIN=admin
# AUTH_PASSWORD=change-me

# SSH/root password used by prepare.py (optional, separate from web login)
# ROOT_PASSWORD=change-me

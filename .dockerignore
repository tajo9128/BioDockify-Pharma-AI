# =============================================================================
# BioDockify Docker Build - Ignore File
# =============================================================================

# Version Control
.git/
.gitignore
.github/
.gitattributes

# Build Artifacts
dist/
build/
*.egg-info/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
*.so

# Node/Bun
node_modules/
.next/
ui/node_modules/
ui/.next/
ui/out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python Virtual Environments
.venv/
.venv311/
venv/
env/
*.venv

# IDE/Editor
.idea/
.vscode/
.gemini/
*.swp
*.swo
*~
.DS_Store

# Desktop App
desktop/
installer/

# Tests
tests/
test_*.py
*_test.py
pytest.ini

# Development Files
*.spec
*.bak
*.backup
*.tmp
local-*
server_log.txt
.pre-commit-config.yaml
.pre-commit-hooks.yaml
.bandit
detect-secrets/

# Data/Output Directories
data/
export/
test_output/
test_slides_output/
mock_cloud_storage/
library_data/
data/test_chroma/
data/vectors/
data/deep_drive/
benchmarks/results/

# External Repos
external_repos/
Prismer_Repo/
external/
_external/

# Lock files (keep bun.lock — Dockerfile COPYs it for reproducible builds)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Docker files
Dockerfile*
docker-compose*.yml

# Secrets
.env
.env.*
*.pem
*.key

# Bonsai model — downloaded via RUN curl in Dockerfile, not COPYied from build context.
# Keeping it out of the context avoids a 1.1 GB duplication and speeds up builds.
Bonsai-8B-Q1_0.gguf
*.gguf

# Graphify cache (graph.json and GRAPH_REPORT.md ARE included for AI agent context)
graphify-out/cache/
graphify-out/converted/
graphify-out/manifest.json
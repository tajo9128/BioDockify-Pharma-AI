# Flattens the 487-layer image into 1 layer so Docker Desktop can load it.
# BuildKit can pull the deep chain; the plain daemon cannot.
ARG SRCTAG=tajo9128/biodockify-pharma-ai:latest
FROM ${SRCTAG} AS source
FROM scratch
COPY --from=source / /

ENV OPENMM_PLUGIN_DIR=/opt/openmm-plugins
ENV LD_LIBRARY_PATH=/usr/local/lib
ENV PIP_DEFAULT_TIMEOUT=120
ENV PATH=/opt/venv-a0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

EXPOSE 50001
VOLUME ["/a0/usr"]
WORKDIR /a0
CMD ["/exe/initialize.sh", "main"]

FROM tajo9128/biodockify-pharma-ai:v7.0.7

COPY . /a0/

# ─── Override stale event listener from base image (dependency-free, no supervisor.childutils) ───
COPY docker/run/fs/exe/supervisor_event_listener.py /exe/supervisor_event_listener.py
RUN chmod +x /exe/supervisor_event_listener.py

# ─── Consolidate all persistent data under /a0/usr (single volume) ───
RUN mkdir -p /a0/usr/data /a0/usr/.a0proj && \
    # Move any existing data into the volume mount point
    [ -d /a0/data ] && [ ! -L /a0/data ] && cp -a /a0/data/. /a0/usr/data/ 2>/dev/null; \
    [ -d /a0/.a0proj ] && [ ! -L /a0/.a0proj ] && cp -a /a0/.a0proj/. /a0/usr/.a0proj/ 2>/dev/null; \
    # Replace with symlinks so all writes go to /a0/usr
    rm -rf /a0/data /a0/.a0proj && \
    ln -s /a0/usr/data /a0/data && \
    ln -s /a0/usr/.a0proj /a0/.a0proj && \
    echo "Symlinks created: /a0/data -> /a0/usr/data, /a0/.a0proj -> /a0/usr/.a0proj"

# ─── Cleanup + Rebrand ───
RUN find /a0/webui/ -maxdepth 1 \( -name "favicon*" -o -name "*.ico" \) -type f -delete 2>/dev/null || true; \
    cp -f /a0/webui/public/favicon.svg /a0/webui/favicon.svg 2>/dev/null || true; \
    cp -f /a0/webui/public/favicon.svg /a0/webui/favicon.ico 2>/dev/null || true; \
    cp -f /a0/webui/public/favicon_round.svg /a0/webui/favicon_round.svg 2>/dev/null || true; \
    cp -f /a0/webui/public/icon.svg /a0/webui/icon.svg 2>/dev/null || true; \
    rm -f /a0/extensions/webui/right-canvas-panels/*.html 2>/dev/null || true; \
    rm -rf /a0/webui/components/docking /a0/webui/components/3d-viewer /a0/webui/components/admet \
           /a0/webui/components/drug-browser /a0/webui/components/mol-similarity \
           /a0/webui/components/chemical-space /a0/webui/components/agent-tasks 2>/dev/null || true; \
    rm -rf /a0/webui/components/qsar /a0/webui/components/qsar3d_old 2>/dev/null || true; \
    rm -rf /a0/modules/qsar 2>/dev/null || true; \
    rm -f /a0/api/qsar.py /a0/api/pharmacophore_old.py 2>/dev/null || true; \
    sed -i 's|Agent Zero|BioDockify AI|g' /a0/prompts/*.md 2>/dev/null || true; \
    sed -i 's|agent_zero|biodockify_ai|g' /a0/prompts/*.md 2>/dev/null || true; \
    sed -i 's|Agent Zero|BioDockify AI|g' /a0/agent_zero/prompts_v19/*.md 2>/dev/null || true; \
    sed -i 's|Agent Zero|BioDockify AI|g' /a0/agent_zero/extensions_v19/python/agent_init/*.py 2>/dev/null || true; \
    sed -i 's|Agent Zero|BioDockify AI|g' /a0/webui/index.html 2>/dev/null || true; \
    sed -i 's|Agent Zero|BioDockify AI|g' /a0/webui/js/*.js 2>/dev/null || true; \
    sed -i 's|Agent Zero|BioDockify AI|g' /a0/helpers/*.py 2>/dev/null || true; \
    sed -i 's|Agent Zero|BioDockify AI|g' /a0/agent.py 2>/dev/null || true; \
    sed -i 's|Agent Zero|BioDockify AI|g' /a0/models.py 2>/dev/null || true

# ─── System packages (RDKit + OpenBabel + Vina) ───
RUN apt-get update -qq && apt-get install -y -qq \
    python3-rdkit openbabel autodock-vina wget 2>/dev/null || true; \
    SYS_PKGS=$(python3 -c "import site; print(site.getsitepackages()[0])"); \
    /opt/venv-a0/bin/python -m pip install rdkit 2>/dev/null || \
      (cp -r $SYS_PKGS/rdkit* /opt/venv-a0/lib/python3.12/site-packages/ 2>/dev/null || true); \
    /opt/venv-a0/bin/python -c "from rdkit import Chem; print('RDKit OK')" 2>/dev/null || echo "RDKit unavailable in venv"

# ─── Framework venv (/opt/venv-a0): core pharma + science packages ───
# Slim image: removed catboost (~500MB), duplicate execution venv, sentence-transformers cache
ENV PIP_DEFAULT_TIMEOUT=120
RUN /opt/venv-a0/bin/python -m pip install --no-cache-dir \
    meeko>=0.5.0 \
    scipy>=1.11.0 scikit-learn>=1.3.0 pandas>=2.0.0 matplotlib>=3.7.0 \
    statsmodels>=0.14.0 seaborn>=0.12.0 plotly>=5.18.0 arxiv>=2.1.0 biopython>=1.83 \
    lifelines>=0.27.0 semanticscholar>=0.6.0 tabulate>=0.9.0 \
    pingouin>=0.5.4 reportlab>=4.0.0 fastapi>=0.110.0 \
    "numpy>=1.24,<2.5" \
    chromadb>=0.4.0 faiss-cpu>=1.7.4 sentence-transformers>=2.2.0 \
    mdtraj>=1.9.9 pdbfixer>=2.0.0 nvidia-ml-py>=11.5.0 \
    xgboost>=2.0.0 lightgbm>=4.0.0

# ─── OpenMM CUDA plugin ───
# pip already installs openmm (CPU-only) via pdbfixer dependency.
# We only need the CUDA platform plugin .so + CUDA runtime from conda-forge.
# IMPORTANT: Do NOT copy conda's Python package — it causes Bus error
# (ABI mismatch between conda's and pip's Python 3.12 builds).
RUN curl -fsSL https://github.com/mamba-org/micromamba-releases/releases/latest/download/micromamba-linux-64 -o /usr/local/bin/micromamba && \
    chmod +x /usr/local/bin/micromamba && \
    export MAMBA_ROOT_PREFIX=/tmp/mamba && \
    micromamba create -y -n omm -c conda-forge openmm cudatoolkit && \
    # Dedicated plugin directory with ALL platform plugins from conda
    mkdir -p /opt/openmm-plugins && \
    cp /tmp/mamba/envs/omm/lib/plugins/libOpenMM*.so /opt/openmm-plugins/ && \
    # System libs: OpenMM core + CUDA runtime (plugins link against these)
    cp -a /tmp/mamba/envs/omm/lib/libOpenMM.so* /usr/local/lib/ && \
    cp -a /tmp/mamba/envs/omm/lib/libcudart.so* /usr/local/lib/ && \
    ldconfig && \
    rm -rf /tmp/mamba /usr/local/bin/micromamba && \
    echo "=== Installed plugins ===" && \
    ls /opt/openmm-plugins/ && \
    echo "=== System libs ===" && \
    ldconfig -p | grep -E "OpenMM|cudart"

# Tell OpenMM where to find platform plugins
ENV OPENMM_PLUGIN_DIR=/opt/openmm-plugins

# ─── Verify critical imports ───
RUN /opt/venv-a0/bin/python -c "\
from rdkit import Chem; print('RDKit OK'); \
from openmm.app import ForceField; \
ff = ForceField('amber14-all.xml', 'tip3p.xml'); \
print('OpenMM + forcefields OK'); \
import openmm as mm; \
platforms = [mm.Platform.getPlatform(i).getName() for i in range(mm.Platform.getNumPlatforms())]; \
print(f'OpenMM platforms: {platforms}'); \
import pynvml; print('nvidia-ml-py (pynvml) OK')" \
    && echo "All critical packages verified" \
    || (echo "ERROR: Critical package import failed" && exit 1)
# Verify CUDA plugin exists
RUN test -f /opt/openmm-plugins/libOpenMMCUDA.so \
    && echo "CUDA plugin OK: /opt/openmm-plugins/libOpenMMCUDA.so ✓" \
    || (echo "ERROR: libOpenMMCUDA.so missing" && exit 1)

# ─── Execution venv: only Flask (framework venv is already the default python3) ───
RUN /opt/venv/bin/python -m pip install --no-cache-dir flask>=3.0.0 \
    && /usr/bin/python3 -m pip install --no-cache-dir supervisor 2>/dev/null || true \
    && echo "Execution venv ready"

# ─── Make framework venv Python the default python3 ───
# The agent's code_execution_tool uses /bin/bash → python3.
# That must resolve to the framework venv (/opt/venv-a0) which has Flask,
# litellm, and all API modules. The execution venv (/opt/venv) is for
# user-installed packages only.
RUN ln -sf /opt/venv-a0/bin/python /usr/local/bin/python3 && \
    ln -sf /opt/venv-a0/bin/python /usr/local/bin/python && \
    ln -sf /opt/venv-a0/bin/pip /usr/local/bin/pip3 && \
    ln -sf /opt/venv-a0/bin/pip /usr/local/bin/pip && \
    echo "Framework venv python3 set as default"

EXPOSE 50001
# Single volume for ALL persistent data (workspace, chats, knowledge, memory)
VOLUME ["/a0/usr"]
HEALTHCHECK --interval=30s --timeout=15s --retries=3 CMD \
  curl -sf http://localhost:80/api/health || exit 1
CMD ["/exe/initialize.sh", "main"]
